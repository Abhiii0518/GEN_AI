# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./sleep_tracker.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# Security & JWT (Placeholder - never commit production secrets)
SECRET_KEY=development-secret-key-change-in-production
JWT_SECRET_KEY=development-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440